#!/usr/bin/env bash

###############################################################################
# OVERTCHAT SETUP – IriX Engine
###############################################################################

[[ "${1:-}" == "--debug" ]] && set -x
set -euo pipefail
export PS4='+ [${BASH_SOURCE}:${LINENO}] '

###############################################################################
# Globals
###############################################################################

OS="$(uname)"
USER_ID="$(id -u)"

###############################################################################
# File Config Default
###############################################################################

default_file="$HOME/Overtchat/config/config-base.json"

###############################################################################
# UI helpers
###############################################################################

valid()   { echo -e "\033[1;32m$*\033[0m"; }
info()    { echo -e "\033[1;34m$*\033[0m"; }
warning() { echo -e "\033[1;33m$*\033[0m"; }
error()   { echo -e "\033[1;31m$*\033[0m"; }

###############################################################################
# Guards
###############################################################################

[[ "$OS" != "Linux" ]] && { error "Système non supporté"; exit 1; }
[[ "$USER_ID" -eq 0 ]] && { error "Ne pas exécuter en root"; exit 1; }

###############################################################################
# Dependencies
###############################################################################

command -v jq >/dev/null 2>&1 || {
    warning "jq manquant – installation"
    sudo apt-get update && sudo apt-get install -y jq
    valid "jq installé"
}

###############################################################################
# Message Accueil
###############################################################################
cat <<'EOF'

                Bienvenue sur le programme Service-Overtchat by SerVuS

EOF

###############################################################################
# Loader Config File
###############################################################################
log="false"

if [[ ! -d "$HOME/Overtchat" && ! -f "$default_file" ]]; then
    read -rp "Vous installez Service-Overtchat. Voulez-vous continuer ? [Y/N] : " rep

    if [[ "$rep" =~ ^[Yy]$ ]]; then
        log="true"
    else
        log="false"
    fi
else
    log="true"
fi

# Si autorisé
if [[ "$log" == "true" ]]; then
    if [[ ! -f "$default_file" ]]; then
        mkdir -p "$HOME/Overtchat/config"; info "Création du dossier > $HOME/Overtchat/config" || {
            error "Impossible de créer le dossier > $HOME/Overtchat/config"; exit 1
        }

        info "Téléchargement du fichier > config-base.json"
        curl -fsSL \
          https://raw.githubusercontent.com/Servus33/Overtchat/main/config/config-base.json \
          -o "$default_file" || {
              error "Échec du téléchargement du fichier de configuration"
              exit 1
          }
    fi
else
    warning "Arrêt du programme."
    exit 0
fi

# Vérification finale stricte
if [[ ! -s "$default_file" ]] || ! jq -e 'type=="object"' "$default_file" >/dev/null 2>&1; then
    error "Fichier < $default_file > config standard invalide ou corrompu"
    exit 1
fi

###############################################################################
# Récupération des données standart
###############################################################################
BASE_DIR="$HOME/$(jq -r '.folders.home' "$default_file")"
info "Load Home > $BASE_DIR"

###############################################################################
# Download from Git
###############################################################################

download_from_github() {
  local repo_path="$1"
  local local_path="$2"
  local GITHUB_OWNER=/$(jq -r '.git.owner' "$default_file")
  local GITHUB_REPO=/$(jq -r '.git.repot' "$default_file")
  local GITHUB_BRANCH=/$(jq -r '.git.branch' "$default_file")
  local GITHUB_BRUTE=/$(jq -r '.git.brutegit' "$default_file")

  info "Download > $repo_path → $local_path"
  curl -fSL \
    -o "$local_path" \
    "$GITHUB_BRUTE/$GITHUB_OWNER/$GITHUB_REPO/$GITHUB_BRANCH/$repo_path"
}

###############################################################################
# Create Directories
###############################################################################

[[ -f "$default_file" ]] && {
info "Load Config File > $default_file"
jq -r '.folders[]' "$default_file" | while read -r dir; do
    mkdir -p "$HOME/$dir"
done } || {
    error "$dir failed"; exit 1
}

###############################################################################
# JSON validation
###############################################################################

validate_json() {
    local f="$1"
    [[ -f "$f" ]] || return 1
    [[ -s "$f" ]] || return 1
    jq -e 'type=="object" and length>0' "$f" >/dev/null || return 1
}

###############################################################################
# Folders Git > /tmp/.Overtchat
###############################################################################

ensure_json() {
  local repo_path="$1"
  local local_path="$2"

  if [[ ! -f "$local_path" ]]; then
    warning "Téléchargement $(basename "$local_path")"
    download_from_github "$repo_path" "$local_path"
  fi

  validate_json "$local_path" || {
    error "JSON invalide : $local_path"
    exit 1
  }
}

###############################################################################
# Create Files JSON
###############################################################################

info "Create & Load Files Json"
jq -r '.json | to_entries[] | .value' "$default_file" | while read -r json_path; do
    # Si le fichier existe et est valide, on continue
    if [[ -f "$HOME/$json_path" ]] && jq -e 'type=="object"' "$HOME/$json_path" >/dev/null 2>&1; then
        continue
    fi

    error "JSON manquant ou invalide : $json_path"

    rel_path="${json_path#"$HOME/Overtchat/"}"

    # Tentative de récupération depuis GitHub
    if ! download_from_github "$rel_path" "$json_path"; then
        warning "Absent du dépôt Git – création d’un JSON vide"
        echo '{}' >"$HOME/$json_path"
    fi

    # Validation finale
    if ! jq -e 'type=="object"' "$HOME/$json_path" >/dev/null 2>&1; then
        error "JSON corrompu : $HOME/$json_path"
        exit 1
    fi
done


###############################################################################
# Merge config (defaults + config)
###############################################################################

DEFAULTS_JSON="$HOME/$(jq -r '.json.defaults' "$default_file")"
CONFIG_JSON="$HOME/$(jq -r '.json.config' "$default_file")"

# defaults.json doit exister
[[ -f "$DEFAULTS_JSON" ]] || {
    error "defaults.json introuvable"
    exit 1
}

# config.json optionnel → fallback {}
[[ -f "$CONFIG_JSON" ]] || echo '{}' >"$HOME/$CONFIG_JSON"

MERGED_CONFIG="$HOME/$(jq -s '
    (.[0] | select(type=="object")) *
    (.[1] | select(type=="object"))
' "$DEFAULTS_JSON" "$CONFIG_JSON")"

jq -e 'type=="object" and length > 0' <<<"$MERGED_CONFIG" >/dev/null || {
    error "Configuration fusionnée invalide"
    exit 1
}

###############################################################################
# Git bootstrap (si activé)
###############################################################################

git_enabled="$(jq -r '.git.enabled // false' <<<"$MERGED_CONFIG")"

bootstrap_git() {
    local repo branch depot

    repo="$(jq -r '.git.repository' <<<"$MERGED_CONFIG")"
    branch="$(jq -r '.git.branch // "main"' <<<"$MERGED_CONFIG")"
    depot="$(jq -r '.git.depot' <<<"$MERGED_CONFIG")"

    [[ -z "$repo" || "$repo" == "null" ]] && {
        error "Configuration Git invalide"
        exit 1
    }

    [[ -d "$depot/.git" ]] && return 0

    warning "Bootstrap Git : $repo ($branch)"
    git clone --depth 1 -b "$branch" "$repo" "$depot" || {
        error "Échec du clone Git"
        exit 1
    }
}

[[ "$git_enabled" == "true" ]] && bootstrap_git

###############################################################################
# Runtime state init
###############################################################################

STATE_JSON="$HOME/$(jq -r '.json.state' "$default_file")"

[[ -f "$STATE_JSON" ]] || cat >"$STATE_JSON" <<EOF
{
  "status": "idle",
  "lastAction": null,
  "lastRun": null,
  "errors": { "count": 0, "last": null }
}
EOF

###############################################################################
# Script resolver
###############################################################################

resolve_script() {
    local name="$1"
    local paths_json rel full

    paths_json="$HOME/$(jq -r '.json.paths' "$default_file")"
    [[ -f "$paths_json" ]] || return 1

    rel="$(jq -r ".scripts.$name // empty" "$paths_json")"
    [[ -z "$rel" ]] && return 1

    full="$BASE_DIR/$rel"
    [[ -f "$full" ]] || return 1

    chmod +x "$full" 2>/dev/null || true
    echo "$full"
}

###############################################################################
# Execute action
###############################################################################

run_action() {
    local action="$1" script

    script="$(resolve_script "$action")" || {
        error "Script introuvable : $action"
        return 1
    }

    info "Exécution : $action"

    jq \
      --arg a "$action" \
      --arg d "$(date -Is)" \
      '.status="running" | .lastAction=$a | .lastRun=$d' \
      "$STATE_JSON" >"$STATE_JSON.tmp" && mv "$STATE_JSON.tmp" "$STATE_JSON"

    if ! bash "$script"; then
        jq '.errors.count += 1 | .errors.last = "'"$action"'"' \
          "$STATE_JSON" >"$STATE_JSON.tmp" && mv "$STATE_JSON.tmp" "$STATE_JSON"
        error "Échec action : $action"
        return 1
    fi

    jq '.status="idle"' "$STATE_JSON" >"$STATE_JSON.tmp" && mv "$STATE_JSON.tmp" "$STATE_JSON"
}

###############################################################################
# Banner
###############################################################################

clear
cat <<EOF
====================================================
        OVERTCHAT – IRIX SETUP
====================================================
EOF

###############################################################################
# Menu
###############################################################################

while true; do
cat <<EOF

    1) Quitter
    2) Control
    3) Install
    4) Uninstall
    5) Init
    6) Update
    7) Status

EOF
    read -rp "Votre choix : " choice

    case "$choice" in
        1) warning "Arrêt"; exit 0 ;;
        2) run_action "control" ;;
        3) run_action "install" ;;
        4) run_action "uninstall" ;;
        5) run_action "init" ;;
        6) run_action "update" ;;
        7) run_action "status" ;;
        *) warning "Choix invalide" ;;
    esac
done
